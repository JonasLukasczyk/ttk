      <CustomProxyDefinition name="Sine" group="sources">
        <CompoundSourceProxy id="13335" servers="1">
          <Proxy group="filters" type="Calculator" id="12581" servers="1" compound_name="Calculator1">
            <Property name="AttributeMode" id="12581.AttributeMode" number_of_elements="1">
              <Element index="0" value="1"/>
              <Domain name="enum" id="12581.AttributeMode.enum">
                <Entry value="1" text="Point Data"/>
                <Entry value="2" text="Cell Data"/>
              </Domain>
            </Property>
            <Property name="CoordinateResults" id="12581.CoordinateResults" number_of_elements="1">
              <Element index="0" value="0"/>
