<?xml version="1.0" encoding="UTF-8"?>

<ServerManagerConfiguration>
  <ProxyGroup name="filters">
    <SourceProxy name="ScalarFieldFromPointsNew" class="ttkScalarFieldFromPointsNew" label="TTK ScalarFieldFromPointsNew">
      <Documentation long_help="ScalarFieldFromPointsNew Long" short_help="ScalarFieldFromPointsNew Short">
        The filter takes as input points from the PathIntegrator module, and for each timestep creates a scalar field.
      </Documentation>

      <!-- INPUT -->
      <InputProperty name="Input" command="SetInputConnection">
        <ProxyGroupDomain name="groups">
          <Group name="sources" />
          <Group name="filters" />
        </ProxyGroupDomain>
        <DataTypeDomain name="input_type">
          <DataType value="vtkMultiBlockDataSet" />
        </DataTypeDomain>
        <InputArrayDomain name="point_array" number_of_components="1"/>
        <Documentation>A vtkMultiBlockDataSet of points.</Documentation>
      </InputProperty>

      <!-- INPUT PARAMETER WIDGETS -->

      <StringVectorProperty 
        name="AmpArray"
        label="Amplitude"
        command="SetInputArrayToProcess"
        element_types="0 0 0 0 2"
        number_of_elements="5" 
        default_values="2 0 0 0 Amps">
        <ArrayListDomain 
          name="amps"
          input_domain_name="point_array"
          >
          <RequiredProperties>
            <Property function="Input" name="Input" />
          </RequiredProperties>
        </ArrayListDomain>
        <Documentation>The array that contains the amplitude. Created by the RandomPointsGenerator module.</Documentation>
      </StringVectorProperty>

      <StringVectorProperty 
        name="SpArray"
        label="Spread"
        command="SetInputArrayToProcess"
        element_types="0 0 0 0 2"
        number_of_elements="5" 
        default_values="3 0 0 0 Spreads">
        <ArrayListDomain 
          name="spreads"
          input_domain_name="point_array"
          >
          <RequiredProperties>
            <Property function="Input" name="Input" />
          </RequiredProperties>
        </ArrayListDomain>
        <Documentation>The array that contains the spread. Created by the RandomPointsGenerator module.</Documentation>
      </StringVectorProperty>

      <StringVectorProperty 
        name="rArray"
        label="Rate"
        command="SetInputArrayToProcess"
        element_types="0 0 0 0 2"
        number_of_elements="5" 
        default_values="4 0 0 0 Rates">
        <ArrayListDomain 
          name="rates"
          input_domain_name="point_array"
          >
          <RequiredProperties>
            <Property function="Input" name="Input" />
          </RequiredProperties>
        </ArrayListDomain>
        <Documentation>The array that contains the rate. Created by the RandomPointsGenerator module.</Documentation>
      </StringVectorProperty> 

      <StringVectorProperty 
        name="btArray"
        label="Birth Time"
        command="SetInputArrayToProcess"
        element_types="0 0 0 0 2"
        number_of_elements="5" 
        default_values="5 0 0 0 BirthTimes">
        <ArrayListDomain 
          name="birthtimes"
          input_domain_name="point_array"
          >
          <RequiredProperties>
            <Property function="Input" name="Input" />
          </RequiredProperties>
        </ArrayListDomain>
        <Documentation>The array that contains the birth time.  Created by the PathIntegrator module.</Documentation>
      </StringVectorProperty> 

      <StringVectorProperty 
        name="dtArray"
        label="Death Time"
        command="SetInputArrayToProcess"
        element_types="0 0 0 0 2"
        number_of_elements="5" 
        default_values="6 0 0 0 DeathTimes">
        <ArrayListDomain 
          name="deathtimes"
          input_domain_name="point_array"
          >
          <RequiredProperties>
            <Property function="Input" name="Input" />
          </RequiredProperties>
        </ArrayListDomain>
        <Documentation>The array that contains the death time. Created by the PathIntegrator module.</Documentation>
      </StringVectorProperty> 

      <!-- Create a UI group that contains all input parameter widgets-->
      <PropertyGroup panel_widget="Line" label="Input Options">
        <Property name="AmpArray" />
        <Property name="SpArray" />
        <Property name="rArray" />
        <Property name="btArray" />
        <Property name="dtArray" />
      </PropertyGroup>      

      <!-- OUTPUT PARAMETER WIDGETS -->

      <DoubleVectorProperty name="ImageBounds"  command="SetImageBounds" default_values="0 1 0 1 0 1" number_of_elements="6" panel_visibility="default">
        <BoundsDomain name="bounds">
          <RequiredProperties>
            <Property function="Input" name="Input" />
          </RequiredProperties>
        </BoundsDomain>
        <Documentation>The bounds for the output scalar field. Should be similar to the domain points were generated in.</Documentation>
      </DoubleVectorProperty>

      <DoubleVectorProperty name="Resolution" command="SetResolution" default_values="1 1 1" number_of_elements="3">
        <Documentation>The resolution of the field. Sets how many points are in the between the bounds.</Documentation>
      </DoubleVectorProperty>

      <DoubleVectorProperty name="Bandwidth" command="SetBandwidth" default_values="1" number_of_elements="1"></DoubleVectorProperty>

      <IntVectorProperty name="Kernel" command="SetKernel" number_of_elements="1" default_values="0">
        <EnumerationDomain name="enum">
          <Entry value="0" text="Gaussian" />
          <Entry value="1" text="Linear" />
          <Entry value="2" text="Epanechnikov" />
          <Entry value="3" text="Constant" />
        </EnumerationDomain>
        <Documentation>Kernel.</Documentation>
      </IntVectorProperty>

      <!-- Create a UI group that contains all output parameter widgets-->
      <PropertyGroup panel_widget="Line" label="Output Options">
        <Property name="ImageBounds" />
        <Property name="Resolution" />
        <Property name="Bandwidth" />
        <Property name="Kernel" />
      </PropertyGroup>      

      <!-- DEBUG -->
      ${DEBUG_WIDGETS}

      <!-- MENU CATEGORY -->
      <Hints>
        <ShowInMenu category="TTK - Misc" />
      </Hints>
    </SourceProxy>
  </ProxyGroup>
</ServerManagerConfiguration>